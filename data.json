                        "desc": { "de": "Fügt beim Sprinten umstehenden Feinden Schaden zu." }
                    },
                    {
                        "name": { "de": "Krit. Treffer durch Perfektes Ausweichen" },
                        "desc": { "de": "Nach Perfekten Ausweichen landen alle Angriffe einige Zeit lang kritische Treffer." }
                    },
                    {
                        "name": { "de": "Kürzeres Cool-down durch Perfektes Blocken" },
